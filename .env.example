# Copia este archivo a `.env.local` (o `.env.<modo>.local`) y ajusta el valor.
# Base URL de la API consumida por el frontend.
# - Desarrollo: el backend local en http://localhost:3000/api/v1
# - Producción: la URL del backend desplegado (o `/api/v1` si se proxya)
VITE_API_BASE_URL=http://localhost:3000/api/v1
